# OpenAI API key - required for the AI agent
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model to use (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Google Sheets - ID of the spreadsheet (from the URL)
# e.g. https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Path to your Google service account credentials JSON file
GOOGLE_CREDENTIALS_FILE=credentials.json

# Name of the worksheet tab in the Google Sheet (default: Menu)
GOOGLE_WORKSHEET_NAME=Menu

# Bring shopping list credentials
BRING_EMAIL=your_bring_email_here
BRING_PASSWORD=your_bring_password_here

# Name of the Bring shopping list to use (default: first list found)
BRING_LIST_NAME=
